VITE_API_URL=http://127.0.0.1:8000/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Identity Services checks the exact page origin.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized JavaScript origins (add every line):
#   http://localhost:5173
#   http://127.0.0.1:5173
# Authorized redirect URIs:
#   http://localhost:5173
#   http://127.0.0.1:5173
# Open the app at http://localhost:5173 — localhost and 127.0.0.1 are different origins.
